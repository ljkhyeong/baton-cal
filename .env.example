POSTGRES_DB=baton_cal
POSTGRES_USER=baton_cal
POSTGRES_PASSWORD=baton_cal
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/baton_cal
DATABASE_USERNAME=baton_cal
DATABASE_PASSWORD=baton_cal
DATABASE_MAXIMUM_POOL_SIZE=10
DATABASE_LOCK_TIMEOUT=5s
DATABASE_STATEMENT_TIMEOUT=30s
DATABASE_TRANSACTION_TIMEOUT=30s
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081

# 예시 값은 32자 미만이라 그대로 복사하면 시작에 실패한다.
BATON_CAL_INTERNAL_TOKEN=replace-with-32-or-more-chars
BATON_CAL_PUBLIC_BASE_URL=http://localhost:8080
BATON_CAL_SUBSCRIPTION_GENERATION=00000000-0000-0000-0000-000000000001
