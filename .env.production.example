# 애플리케이션 입력 예시. 실제 값은 환경변수 또는 Secret 파일로 전달한다.
# .env 파일은 Spring Boot가 자동으로 읽지 않는다. docs/integration-runtime.md 참고.
SPRING_PROFILES_ACTIVE=prod
SPRING_CONFIG_IMPORT=configtree:/run/secrets/baton-cal/

DATABASE_URL=jdbc:postgresql://postgres:5432/baton_cal
DATABASE_USERNAME=baton_cal
DATABASE_MAXIMUM_POOL_SIZE=10

SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
# k3s 생존·준비 점검은 SERVER_PORT의 /livez, /readyz를 사용한다.
# 프로토콜: prod는 HTTP, prod,tls는 HTTPS.
BATON_CAL_PUBLIC_BASE_URL=https://cal.b4ton.com
# 새 DB 최초 실행 때 UUID를 정하고, 일반 재시작·배포에서는 유지한다.
BATON_CAL_SUBSCRIPTION_GENERATION=
BATON_CAL_RECOVERY_MODE=false

# CAL이 직접 HTTPS를 제공할 때만 활성화한다. 이때 8080은 HTTPS다.
# SPRING_PROFILES_ACTIVE=prod,tls
# BATON_CAL_TLS_CERTIFICATE=file:/run/secrets/baton-cal-tls/tls.crt
# BATON_CAL_TLS_PRIVATE_KEY=file:/run/secrets/baton-cal-tls/tls.key

# /run/secrets/baton-cal/ 필수 파일: DATABASE_PASSWORD, BATON_CAL_INTERNAL_TOKEN
# BATON과 연결할 내부 토큰은 32~200자, 영문·숫자와 -._~만 사용한다.
# 이전 토큰은 회전할 때만 baton.cal.previous-internal-token 파일로 추가한다.
# 인증서 교체와 Secret 값 변경 후 애플리케이션을 재시작한다.
