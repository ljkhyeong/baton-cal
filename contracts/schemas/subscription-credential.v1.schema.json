{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cal.baton/contracts/schemas/subscription-credential.v1.schema.json",
  "title": "SubscriptionCredentialV1",
  "description": "구독 생성 또는 회전 호출이 성공할 때 한 번만 반환되는 비밀 응답입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subscriptionId",
    "token",
    "feedUrl"
  ],
  "properties": {
    "subscriptionId": {
      "type": "string",
      "format": "uuid"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "feedUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://[^?#]+/calendars/v1/[A-Za-z0-9_-]{43}\\.ics$"
    }
  }
}
