{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cal.baton/contracts/schemas/schedule-snapshot-batch-result.v1.schema.json",
  "title": "ScheduleSnapshotBatchResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "result"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "result": {
            "$ref": "schedule-snapshot-result.v1.schema.json#/properties/result"
          }
        }
      }
    }
  }
}
