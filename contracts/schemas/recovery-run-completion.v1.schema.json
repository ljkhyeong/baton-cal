{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cal.baton/contracts/schemas/recovery-run-completion.v1.schema.json",
  "title": "RecoveryRunCompletionV1",
  "description": "BATON이 계산한 전체 시즌 매니페스트의 개수와 다이제스트입니다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seasonCount", "seasonDigest"],
  "properties": {
    "seasonCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "seasonDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
