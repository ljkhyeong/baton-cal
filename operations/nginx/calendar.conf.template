limit_req_zone $binary_remote_addr zone=calendar_requests:10m rate=${CAL_REQUEST_RATE};
limit_conn_zone $binary_remote_addr zone=calendar_connections:10m;
resolver 127.0.0.11 valid=10s ipv6=off;
upstream calendar_backend {
    zone calendar_backend 64k;
    server app:8080 resolve;
    keepalive 16;
}

server {
    listen 80;
    server_name cal.b4ton.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://cal.b4ton.com$uri; }
}

server {
    listen 443 ssl;
    server_name cal.b4ton.com;
    ssl_certificate /etc/letsencrypt/live/cal.b4ton.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cal.b4ton.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CalendarTLS:10m;
    client_max_body_size 1k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 30s;

    location ^~ /calendars/v1/ {
        if ($request_method !~ ^(GET|HEAD)$) { return 405; }
        limit_req zone=calendar_requests burst=${CAL_REQUEST_BURST} nodelay;
        limit_conn calendar_connections ${CAL_CONNECTION_LIMIT};
        limit_req_status 429;
        limit_conn_status 429;
        error_page 429 = @limited;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_pass_request_body off;
        proxy_set_header Host cal.b4ton.com;
        proxy_set_header Connection "";
        proxy_set_header Content-Length "";
        proxy_set_header If-None-Match $http_if_none_match;
        proxy_set_header If-Modified-Since $http_if_modified_since;
        proxy_connect_timeout 2s;
        proxy_read_timeout 35s;
        proxy_cache off;
        # 쿼리와 원문 요청 헤더는 CAL로 전달하지 않는다.
        proxy_pass http://calendar_backend$uri;
    }
    location @limited {
        add_header Retry-After 1 always;
        add_header Cache-Control no-store always;
        return 429;
    }
    location / { return 404; }
}
